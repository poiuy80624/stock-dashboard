# 複製成 .env 後填入真實 token（.env 已被 .gitignore 忽略，切勿 commit）
FINMIND_TOKEN=

# 本機網頁「AI 對話分析」用的 Anthropic API 金鑰（與 Claude 訂閱分開計費；到 Anthropic Console 申請）
ANTHROPIC_API_KEY=
# 選填：預設用 claude-opus-5-5，想省費用可改成 claude-sonnet-5-5
# AC_CHAT_MODEL=claude-sonnet-5-5
# 選填：思考強度 low / medium / high（預設 medium）
# AC_CHAT_EFFORT=medium
